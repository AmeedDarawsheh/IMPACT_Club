<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.UserAddProjectController">
   <children>
      <Button layoutX="14.0" layoutY="349.0" mnemonicParsing="false" onAction="#cancel" prefWidth="126.0" style="-fx-background-color: white; -fx-background-radius: 20;" text="Cancel" AnchorPane.leftAnchor="14.0">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Button>
      <Button layoutX="160.0" layoutY="349.0" mnemonicParsing="false" onAction="#Add" prefHeight="25.0" prefWidth="126.0" style="-fx-background-color: #212936; -fx-background-radius: 20;" text="Add Project" textFill="WHITE" AnchorPane.rightAnchor="14.0">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
      <ListView fx:id="listOfProjects" layoutX="22.0" layoutY="14.0" prefHeight="302.0" prefWidth="256.0" AnchorPane.topAnchor="12.0" />
   </children>
</AnchorPane>
