<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="302.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.UserFeedBackController">
   <children>
      <AnchorPane layoutX="10.0" layoutY="-133.0" prefHeight="409.0" prefWidth="292.0" style="-fx-background-color: white;">
         <children>
            <Button layoutX="14.0" layoutY="349.0" mnemonicParsing="false" onAction="#cancel" prefWidth="126.0" style="-fx-background-color: white; -fx-background-radius: 20;" text="Cancel" AnchorPane.leftAnchor="14.0">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
            <Button layoutX="160.0" layoutY="349.0" mnemonicParsing="false" onAction="#submitFeedback" prefHeight="25.0" prefWidth="126.0" style="-fx-background-color: #212936; -fx-background-radius: 20;" text="Send" textFill="WHITE" AnchorPane.rightAnchor="14.0">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <TextArea fx:id="feedbackTextArea" layoutX="22.0" layoutY="188.0" prefHeight="155.0" prefWidth="256.0" promptText="Text your feedback here" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
